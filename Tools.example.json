{
  // Copy this file to Tools.json to use it. Comments and trailing commas are allowed.
  // A new "id" adds a tool. An "id" that matches a built-in one replaces it.
  // Any path may hold %DINGO_TOOL_ROOT%, which Dingo replaces with the tools
  // folder from the Options tab. Use it for a tool with no installer of its own.
  "tools": [
    {
      "id": "tool-hxd",
      "name": "HxD",
      "category": "Text and data",
      "description": "Hex editor for binary files.",
      "install": { "kind": "winget", "package": "MHNexus.HxD", "scope": "machine" },
      "detect": [
        { "kind": "uninstall-key", "match": "HxD*" },
        { "kind": "file", "path": "%ProgramFiles%/HxD/HxD.exe" }
      ],
      // Optional. Add this when the installer makes no shortcut of its own.
      // A target that is not on disk is skipped, not treated as a failure.
      "shortcuts": [
        { "name": "HxD", "target": "%ProgramFiles%/HxD/HxD.exe" }
      ],
      // Optional. Windows only hands over a file type nothing has claimed yet.
      // A type another app already owns is reported on the card, not failed.
      "associations": [
        { "extension": ".bin", "target": "%ProgramFiles%/HxD/HxD.exe", "description": "Binary file" }
      ]
    },
    {
      "id": "tool-everything",
      "name": "Everything",
      "category": "Text and data",
      "description": "Instant file-name search across every NTFS volume.",
      "install": { "kind": "winget", "package": "voidtools.Everything", "scope": "machine" },
      "detect": [
        { "kind": "uninstall-key", "match": "Everything*" }
      ]
    },
    {
      // A tool with no installer, shipped as a zip on its own GitHub releases page.
      // Name the repository, never an address. Dingo builds the address itself,
      // reads the latest release, and unpacks the one matching zip into "dest".
      // The pattern may hold * and ?, and must match exactly one file.
      "id": "tool-chainsaw",
      "name": "Chainsaw",
      "category": "Event logs",
      "description": "Searches Windows event logs and other artefacts with Sigma rules.",
      "install": {
        "kind": "github-release",
        "repo": "WithSecureLabs/chainsaw",
        "assetPattern": "chainsaw_x86_64-pc-windows-msvc.zip",
        "dest": "%DINGO_TOOL_ROOT%/Chainsaw",
        "scope": "machine"
      },
      // The PATH card writes one launcher for each program found here. This zip
      // holds a chainsaw folder, so the search has to go down a level.
      // Add "name" when the program file carries its version, so one launcher
      // under a steady name points at the newest copy.
      "shims": { "from": "%DINGO_TOOL_ROOT%/Chainsaw", "pattern": "chainsaw.exe", "recurse": true },
      "detect": [
        { "kind": "file", "path": "%DINGO_TOOL_ROOT%/Chainsaw/chainsaw/chainsaw.exe" }
      ]
    }
  ]
}
